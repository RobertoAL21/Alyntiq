APP_NAME=Alyntiq API
APP_ENV=development
DEBUG=true

POSTGRES_DB=alyntiq
POSTGRES_USER=alyntiq
# Replace this local-development placeholder before starting Docker Compose.
POSTGRES_PASSWORD=replace-me

DATABASE_URL=postgresql+psycopg://alyntiq:replace-me@localhost:5432/alyntiq
REDIS_URL=redis://localhost:6379/0

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_DATA_FEED=iex

MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_ARTIFACT_URI=file:./mlruns/artifacts
MLFLOW_EXPERIMENT_NAME=alyntiq-baselines

OTEL_SERVICE_NAME=alyntiq-api
# Set to an OTLP/HTTP collector base URL when telemetry export is available.
OTEL_EXPORTER_OTLP_ENDPOINT=

TRADING_ENVIRONMENT=paper
# Required only to create, validate, arm, or disarm a paper deployment from the dashboard.
# Generate a distinct local value; do not commit it or expose it in browser configuration.
DASHBOARD_CONTROL_TOKEN=
